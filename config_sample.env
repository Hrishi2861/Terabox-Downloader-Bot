# Telegram bot credentials (from @BotFather and https://my.telegram.org)
BOT_TOKEN=
TELEGRAM_API=
TELEGRAM_HASH=

# Force-subscribe channel and dump channel (use -100... IDs)
FSUB_ID=
DUMP_CHAT_ID=

# Optional user session for 4 GB uploads and faster transfers
USER_SESSION_STRING=
USER_SESSION_INDEXING=

# Owner and MongoDB
OWNER_ID=
MONGO_URI=
INDEX_CHAT_ID=

# Terabox download API base URL, e.g. http://your-server:8000
DOWNLOAD_API=

# Web server port
PORT=

# Minimum seconds between Telegram media sends (optional, default 1.0)
TELEGRAM_MEDIA_DELAY=
